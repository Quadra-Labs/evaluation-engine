# Copy to .env and fill in what you use.
#
# NEVER commit a real key. TEE_PRIVATE_KEY below IS the enclave's identity on the dev path, and
# DEPLOYER_PRIVATE_KEY owns every contract. Both are read for presence only and never logged.

# ---------------------------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------------------------
# Coston2. Contract addresses come from contracts/deployments/<chainId>.json when that file is
# reachable, so a redeploy needs no change here. Set them explicitly only to point elsewhere.
CHAIN_ID=114
CHAIN_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
JOB_ESCROW=
SEALED_COMPETITION=
TEE_REGISTRY=
# The floor for log scans. The public Coston2 RPC caps eth_getLogs at 30 blocks per request, so
# scanning from genesis is thousands of round trips. Set the deploy block: 33930846 on the current
# deployment (redeployed 2026-08-11; it was 33869267 before).
#
# THIS VALUE DOES NOT PROPAGATE. Contract addresses come from contracts/deployments/114.json and
# update themselves; this one lives in your own .env, which is gitignored — so pulling a redeploy
# changes this example file and nothing you actually run. Copy the new number across by hand.
#
# Too LOW is merely slow (old-contract events are filtered out by address anyway). Too HIGH
# silently hides events below the floor, so never set it past the deploy block.
FROM_BLOCK=33930846

# ---------------------------------------------------------------------------------------------
# Ground truth
# ---------------------------------------------------------------------------------------------
# Flare's DA layer. The engine reads this DIRECTLY and never through the data repo's gateway: an
# operator who could serve the price could forge a settlement the contract would still accept.
DA_URL=https://ctn2-data-availability.flare.network
# Not required on Coston2. Set it only if the endpoint you point at asks for one.
DA_API_KEY=

# ---------------------------------------------------------------------------------------------
# TEE identity
# ---------------------------------------------------------------------------------------------
# DEV ONLY (secret). Pins the engine's key across restarts so agents do not have to re-seal after
# every boot. Under FCC this must be unset — the key belongs to the node and the engine holds none.
# Left blank a fresh key is generated at boot and must be re-bound with `pnpm register-tee`.
TEE_PRIVATE_KEY=
# The container image digest this instance runs, written into TeeRegistry alongside the key and
# recorded in every receipt. quadra-verify compares the two. Leave it EMPTY rather than setting a
# placeholder: an empty digest reports "skipped", a fake one reports a passing check that attests
# to nothing.
TEE_IMAGE_DIGEST=
# Return a simulated attestation token from GET /attestation instead of asking the Confidential
# Space launcher. Required anywhere that is not a real Confidential Space VM.
SIMULATE_ATTESTATION=true

# ---------------------------------------------------------------------------------------------
# The EIP-712 service
# ---------------------------------------------------------------------------------------------
TEE_PORT=3000
LOG_LEVEL=info
# Shared secret the intake engine presents as `x-intake-token` on /validate, /score-job,
# /score-market and /settle-competition. Unset means no check, which is fine for a loopback dev run
# but not on a shared host: /validate is the call that decides whether an escrow pays out. Must
# match INTAKE_INTERNAL_TOKEN in the intake engine's environment.
INTAKE_INTERNAL_TOKEN=
# Outbound limits. This workload runs inside a confidential enclave, so unbounded egress is a
# finding rather than a feature: every response is capped and every request is timed out.
HTTP_TIMEOUT_MS=15000
HTTP_MAX_BYTES=2000000

# ---------------------------------------------------------------------------------------------
# Scoring fallbacks
# ---------------------------------------------------------------------------------------------
# Used only when a competition's own evaluatorId does not name an asset. A paid job never falls
# back: its feed comes from the params recorded in JobPaid.
DEFAULT_FEED=BTC/USD
DEFAULT_LIFETIME_SECS=3600

# ---------------------------------------------------------------------------------------------
# `pnpm register-tee` — binds this instance into TeeRegistry (dev path)
# ---------------------------------------------------------------------------------------------
# The contract owner's key (secret). setActiveTee is onlyOwner. This is NOT the TEE key.
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------------------------
# Flare Confidential Compute
# ---------------------------------------------------------------------------------------------
# Where the extension listens, and where Flare's TEE node serves /decrypt. Both are injected by
# the compose stack; the defaults here match the scaffold. Read the env var rather than assuming
# a default — Flare's own docs publish two different values for SIGN_PORT.
EXTENSION_PORT=7702
SIGN_PORT=7701
# 1 = simulated attestation, pairs with SIMULATED_TEE=true in the scaffold's .env. 0 = production
# on a real Confidential Space VM. A mismatch surfaces as "code hashes do not match".
MODE=1
# The measured code hash, reported by the proxy's /info. Recorded in receipts. On a simulated TEE
# this is Flare's fixed 0x194844cf... value.
TEE_CODE_HASH=
# Written by the scaffold's pre-build.sh into config/extension.env. Both are needed to bind the
# on-chain sender to the extension.
EXTENSION_ID=
INSTRUCTION_SENDER=
# The PUBLIC HTTPS URL of your tunnel to host port 6674. It is stored on chain during
# register-tee, so it must survive restarts: use a named Cloudflare tunnel or a reserved ngrok
# domain. A quick tunnel mints a new hostname each run and the registered URL dead-ends silently.
EXT_PROXY_URL=
